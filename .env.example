# Environment variables for the school portal
# Copy this file to .env.local and fill in your values

# Local development: SQLite database path, relative to the project root.
# Neon production: replace this with the pooled PostgreSQL connection string
# from Neon, including its sslmode=require query parameter.
DATABASE_URL="file:./portal.db"

# Session signing secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="REPLACE_WITH_SECURE_RANDOM_STRING_32_CHARS"

# Admin credentials (set these to your desired admin login)
ADMIN_USERNAME="admin"
# Generate a bcrypt hash with: node -e "const b=require('bcryptjs');b.hash('your_password',12).then(console.log)"
# Escape every $ as \$ when pasting a bcrypt hash into a .env file, so Next.js does not expand it.
ADMIN_PASSWORD_HASH="REPLACE_WITH_BCRYPT_HASH_OF_YOUR_PASSWORD"
